{
  "name": "dsh-x-search",
  "version": "0.2.0",
  "description": "X (twitter) search & read toolkit for DeepSeek Harness: computes x-client-transaction-id itself, so searching users, timelines and threads needs no browser — just the auth_token/ct0 already in your browser.",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./package.json": "./package.json",
    "./cordis.patch.yml": "./cordis.patch.yml"
  },
  "files": [
    "lib/",
    "cordis.patch.yml",
    "README.md",
    "INSTALL.md",
    "scripts/",
    "test/unit.mjs"
  ],
  "keywords": [
    "deepseek-harness",
    "dsh",
    "dsh-plugin",
    "twitter",
    "x",
    "search",
    "read-only"
  ],
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/wuyaomin248-stack/dsh-x-search.git"
  },
  "bugs": {
    "url": "https://github.com/wuyaomin248-stack/dsh-x-search/issues"
  },
  "homepage": "https://github.com/wuyaomin248-stack/dsh-x-search#readme",
  "scripts": {
    "check": "node scripts/check.mjs",
    "test": "node scripts/check.mjs",
    "test:unit": "node test/unit.mjs"
  },
  "engines": {
    "node": ">=20"
  },
  "dependencies": {
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependencies": {
    "@deepseek-ai/cordis": "^4.0.1",
    "@deepseek-ai/dsh-tools": "^0.1.7-rc.1 || ^0.2.0-rc.1",
    "@deepseek-ai/schemastery": "^3.18.4"
  },
  "peerDependenciesMeta": {
    "@deepseek-ai/cordis": {
      "optional": true
    },
    "@deepseek-ai/dsh-tools": {
      "optional": true
    },
    "@deepseek-ai/schemastery": {
      "optional": true
    }
  },
  "dsh": {
    "bundle": {
      "patch": "cordis.patch.yml"
    },
    "engines": {
      "dsh": ">=0.1.7-rc.1"
    }
  }
}
